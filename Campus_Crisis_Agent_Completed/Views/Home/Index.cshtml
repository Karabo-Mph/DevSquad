@model List<Campus_Crisis_Agent.Models.CampusReport>
@{ViewData["Title"]="Campus Crisis Agent";}
<div class="container py-4">
<h1>Campus Crisis Agent</h1><p class="text-muted">Monitor, triage and respond to campus reports.</p>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="card p-3"><b>Total reports</b><h2>@ViewBag.Total</h2></div></div><div class="col-md-4"><div class="card p-3 border-danger"><b>Critical</b><h2>@ViewBag.Critical</h2></div></div><div class="col-md-4"><div class="card p-3 border-warning"><b>High priority</b><h2>@ViewBag.High</h2></div></div></div>
<div class="card p-4 mb-4"><h3>Submit report</h3><form method="post" action="/Home/Create" class="row g-2">
<input name="Location" class="form-control" placeholder="Location" required/><input name="Category" class="form-control" placeholder="Category" required/><select name="ReportedSeverity" class="form-select"><option>Low</option><option>Medium</option><option>High</option><option>Emergency</option></select><input name="ReporterType" class="form-control" placeholder="Reporter type"/><textarea name="Description" class="form-control" placeholder="Describe the incident" required></textarea><button class="btn btn-primary">Submit and triage</button></form></div>
<div class="card p-3"><h3>Reports</h3><form class="row g-2 mb-3"><input name="search" class="form-control col" placeholder="Search reports"/><select name="priority" class="form-select"><option value="">All priorities</option><option>Critical</option><option>High</option><option>Normal</option></select><button class="btn btn-outline-secondary">Filter</button></form>
<table class="table table-striped"><thead><tr><th>Location</th><th>Category</th><th>Priority</th><th>Description</th><th>Action</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.Location</td><td>@r.Category</td><td><span class="badge @(r.Priority=="Critical"?"bg-danger":r.Priority=="High"?"bg-warning text-dark":"bg-success")">@r.Priority</span></td><td>@r.Description</td><td>@r.RecommendedAction</td></tr>}</tbody></table></div></div>